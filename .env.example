# ============================================================
# FlorusPocus — Variables d'environnement (EXEMPLE SEULEMENT)
# Copier ce fichier vers .env.local et remplir les vraies valeurs
# NE JAMAIS commiter .env.local
# ============================================================

# --- PUBLIC (visibles côté client) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SQUARE_APP_ID=your-square-app-id-here

# --- SERVEUR UNIQUEMENT (jamais exposées au frontend) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SQUARE_SECRET_API_KEY=your-square-secret-key-here

# --- ENV ---
NODE_ENV=development
